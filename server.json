{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.statuser-cloud/mcp",
  "title": "Statuser",
  "description": "Monitor services, manage incidents and status pages in Statuser.cloud from your AI assistant.",
  "websiteUrl": "https://statuser.cloud",
  "repository": {
    "url": "https://github.com/statuser-cloud/mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://s3.statuser.cloud/logo-v2-icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "version": "0.4.6",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@statuser/mcp",
      "version": "0.4.6",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "STATUSER_API_KEY",
          "description": "Statuser API key, created at https://statuser.cloud/my/account/api-keys",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "STATUSER_ALLOW_WRITE",
          "description": "Set to 1 to allow write tools without a per-call confirm",
          "isRequired": false
        },
        {
          "name": "STATUSER_TOOLSETS",
          "description": "Comma-separated toolsets to enable, or all",
          "isRequired": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.statuser.cloud",
      "headers": [
        {
          "name": "Authorization",
          "description": "Statuser API key as a bearer token",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "Statuser API key, created at https://statuser.cloud/my/account/api-keys",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
